[Unit]
Description=Obrain — inscrit la flotte de chaque compte dans sa base (nœuds « machine: »)
# ── À QUOI SERT CE SERVICE ─────────────────────────────────────────────────
# Il exécute la passe qui fait de la flotte un FAIT DU GRAPHE : chaque compte
# apprend, dans SA base, quelles machines sont les siennes
# (docs/ACCEPTATION-FLOTTE-2026-09-16.md §9.4).
#
# ── POURQUOI UN SERVICE SÉPARÉ, ET POURQUOI PAS DANS LE MOTEUR ─────────────
# Parce que le moteur sert ses bases en LECTURE (verrou partagé) : il ne PEUT
# pas écrire ces nœuds lui-même, et ce n'est pas un défaut à contourner — c'est
# l'invariant mono-écrivain qui protège les données. Faire de la flotte un fait
# du graphe est donc un geste SÉPARÉ, exactement comme `obrain memoire
# --appliquer` et son timer.
#
# ── POURQUOI LA CIBLE EST LA BASE DE CHAQUE COMPTE ─────────────────────────
# Et non la base SERVIE : un timer qui viserait celle-ci échouerait à chaque
# passage, puisque le moteur la tient en lecture pendant qu'il l'expose. Un
# timer qui échoue toujours est un timer qu'on apprend à ignorer — le motif de
# défaillance que ce dépôt refuse sous toutes ses formes. Les bases
# `selfs/<compte>.obrain` ne sont tenues par aucun service : la passe y écrit,
# et chaque compte y trouve SES machines (décision du 2026-09-16 : la flotte est
# une affaire de compte).
Documentation=file:%h/projects/banc-obrain-tronc/docs/ACCEPTATION-FLOTTE-2026-09-16.md

[Service]
Type=oneshot
# OBRAIN_BIN (le binaire à utiliser) et OBRAIN_VIZ_CACHE_DIR (où vit le registre
# des machines) viennent d'ici. Facultatif : le script a des défauts explicites,
# et il DIT quand il ne trouve pas de binaire au lieu de ne rien faire.
EnvironmentFile=-%h/.config/obrain/machines.env
# Le script refuse explicitement un binaire qui ne connaît pas la sous-commande
# « machines » : sans cette garde, un déploiement en retard ferait échouer
# chaque passage en silence, et personne ne lirait les journaux d'un timer.
ExecStart=%h/projects/banc-obrain-tronc/scripts/machines-appliquer-comptes.sh
Nice=10
SyslogIdentifier=obrain-machines
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
