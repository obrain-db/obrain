    opt_verbose["-v, --verbose<br/>global = true<br/>journalisation niveau DEBUG"]
    opt_nocolor["--no-color<br/>global = true<br/>respecte aussi la variable NO_COLOR"]
    opt_color["--color<br/>global = true<br/>conflicts_with = no_color"]
  end

  subgraph Amont["Ce que le CLI lit dans son environnement, pas dans ses arguments"]
    env_vars["variables lues dans le code<br/>⚪ existe en amont<br/>OBRAIN_STORE : store par defaut de mcp et bridge<br/>OBRAIN_WRITE = 1 : ouvre l ecriture du pont<br/>OBRAIN_QUERY_TIMEOUT_MS : defaut 30000 ms au pont, 60000 ms au CLI<br/>OBRAIN_OPEN_RETRY_MS : defaut 10000 ms<br/>NO_COLOR"]
  end

