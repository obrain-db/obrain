%% Ce que ce diagramme prouve : l arbre COMPLET des sous-commandes du binaire CLI obrain,
%% avec pour chacune ses options principales et leur valeur par defaut.
%% Source : crates/obrain-cli lu ligne a ligne — l enum Commands de src/main.rs lignes
%% 113-482, les enums IndexCommands, BackupCommands, DataCommands, WalCommands lignes
%% 484-611 du meme fichier, puis TopoCommands, JumpCommands, JournalCommands,
%% VizCommands, IamCommands dans commands/, et les structs MemoireArgs, EntretienArgs,
%% McpArgs dans commands/ et mcp_server.rs. Le binaire est declare au Cargo.toml du
%% crate, section bin : name = obrain, path = src/main.rs.
%% Mesure : 34 variantes de premier niveau dans Commands — 33 avec un corps plus
%% Version sans argument ; IamCommands 20 ; VizCommands 8 ; IndexCommands 4 ;
%% TopoCommands 3 ; JumpCommands 3 ; BackupCommands 2 ; DataCommands 2 ; WalCommands 2 ;
%% JournalCommands 1. Comptes obtenus par grep sur les enums. Chaque nombre de lignes
%% vient de wc -l sur le fichier cite ; chaque valeur par defaut vient d un attribut
%% default_value ou default_value_t de clap ; chaque conflit vient d un conflicts_with.
%% DEDUIT et non mesure : la graphie KEBAB-CASE des verbes en ligne de commande
%% — repair-degrees, harness-serve, mot-de-passe, jeton-revoquer — est la derivation par
%% defaut de clap a partir des noms de variantes Rust. Aucun attribut rename_all
%% n existe dans le crate, mais AUCUN BINAIRE COMPILE n etait disponible — ni
%% target/release/obrain ni target/debug/obrain — donc obrain --help n a pas pu etre
%% execute pour confirmer la graphie ni le texte d aide.
%% Non etabli : le comportement a l execution de chaque verbe et ses sorties reelles ;
%% les codes de sortie autres que 0, 1 et 2, seuls lus dans l enum ExitCode de main.rs.
%% Un etat mesure merite d etre signale : les 2 verbes du sous-groupe backup existent
%% toujours dans l enum, mais commands/backup.rs ligne 33 rend une erreur de
%% depreciation — ils sont donc dessines 🔴 et non comme des capacites vivantes.

flowchart TB

  obrain["bin obrain<br/>crates/obrain-cli<br/>Cargo.toml section bin : name = obrain, path = src/main.rs<br/>main.rs : 802 lignes<br/>crate : 40 483 lignes .rs<br/>clap Parser + Subcommand"]

  subgraph Global["Options globales : portees par la racine Cli, valables sur toute sous-commande"]
    opt_format["--format<br/>global = true<br/>defaut : auto<br/>auto, table, json, csv"]
