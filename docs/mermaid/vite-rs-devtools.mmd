    nobusy_test["tests/no_busy.rs - 115 lignes, 1 test<br/>4 workers pour 64 clients - exige 64 reponses 200<br/>et un compteur REJECTED fige"]
    aletheia_host["aletheia/miner/src/host.rs - 1486 lignes<br/>hors du crate - monte http::serve, StaticFiles et DevState<br/>journal /tmp/aletheia-front.log"]
  end

