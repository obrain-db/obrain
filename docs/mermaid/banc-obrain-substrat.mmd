    file_mod["file.rs<br/>2533 lignes<br/>ZoneFile mmap et noms de zones"]
    writer_mod["writer.rs<br/>4630 lignes<br/>WAL puis mmap"]
    wal_mod["wal.rs<br/>1185 lignes<br/>trames de journal"]
    store_mod["store.rs<br/>34 172 lignes<br/>SubstrateStore"]
    dict_mod["dict.rs<br/>1203 lignes<br/>dictionnaires persistants"]
  end

  subgraph Enregistrements["Enregistrements Pod repr(C) : stride fixe, taille verrouillee par assert de compilation"]
    node_rec["✅ NodeRecord<br/>40 B, align 8<br/>label_bitset u64, first_edge_off U48,<br/>first_prop_off U48, community_id u32,<br/>energy u16 Q1.15, scar_util_affinity u16,<br/>centrality_cached u16 Q0.16, flags u16,<br/>tenant_id u32, _reserve u32"]
    u48["✅ U48<br/>6 B little-endian<br/>offset interne 48 bits<br/>0 = fin de chaine"]
    edge_rec["✅ EdgeRecord<br/>36 B, align 4<br/>src u32, dst u32, edge_type u16,<br/>weight_u16 Q0.16, next_from U48, next_to U48,<br/>first_prop_off U48, ricci_u8, flags u8,<br/>engram_tag u16, _pad 2"]
    simplex_rec["✅ SimplexRecord<br/>32 B<br/>kind 2 triangle, 3 K4, 4 K5,<br/>255 hyperarete"]
    node_flags["node_flags<br/>TOMBSTONED 1 bit 0<br/>CENTRALITY_STALE, EMBEDDING_STALE,<br/>ENGRAM_SEED, HILBERT_DIRTY, IDENTITY<br/>ALLOCATED 1 bit 6"]
    edge_flags["edge_flags<br/>TOMBSTONED, RICCI_STALE,<br/>COACT, SYNAPSE_ACTIVE, BRIDGE"]
    page_alloc["Allocation des noeuds<br/>NODES_PER_PAGE = 512<br/>NODE_ALLOC_PAGE_BYTES = 20 480<br/>5 pages OS, zero octet perdu"]
    v3_magic["NODES_ZONE_V3_MAGIC<br/>NODESv3 grave dans le slot 0<br/>jamais vivant, flags a 0"]
  end

  subgraph Pages["Pages de 4 KiB et tas : en-tete en tete de page, magics distincts par proprietaire"]
    prop_hdr["✅ PropertyPageHeader<br/>24 B sans remplissage<br/>magic u32, node_id u32, crc32 u32,<br/>next_page U48, entry_count u16,<br/>free_offset u16, tombstones u16"]
    prop_page["✅ PropertyPage<br/>4096 B = en-tete 24 B + payload 4072 B"]
    prop_magic["PROP_PAGE_MAGIC_NODE 0xF5075FA6<br/>PROP_PAGE_MAGIC_EDGE 0xE5075FA6<br/>le genre du proprietaire EST le magic"]
    entry["✅ PropertyEntry<br/>flags u8, prop_key u16 LE, tag u8<br/>ENTRY_HEADER_SIZE = 4<br/>9 ValueTag de Null a ArrStringRef"]
    heapref["✅ HeapRef<br/>8 B : page_id u32, offset u32"]
    heap_page["✅ HeapPage<br/>4096 B = en-tete 16 B + payload 4080 B<br/>HEAP_PAGE_MAGIC 0xF1EA95FF<br/>magic, page_id, crc32,<br/>entry_count u16, free_offset u16"]
    heap_read["HeapPage::read_at<br/>borne sur free_offset, jamais payload.len<br/>une longueur corrompue est REFUSEE"]
  end

  subgraph ZoneV2["Zone de proprietes v2 : deux fichiers mmapes, une chaine par proprietaire"]
    props_v2["✅ substrate.props.v2<br/>tableau de pages de 4 KiB<br/>page 0 sentinelle, pages reelles a partir de 1<br/>taille initiale 2 pages, croissance x1.5"]
    heap_v2["✅ substrate.props.heap.v2<br/>tas append-only, entrees jamais deplacees<br/>taille initiale 1 page"]
    acheve["✅ substrate.props.v2.acheve<br/>marqueur de migration ACHEVEE,<br/>ecrit en tmp + rename, contenu non vide"]
    propszone_obj["PropsZone<br/>props, heap, next_page_idx,<br/>next_heap_page_idx, carrier_pack_ouvert"]
    frontier["compute_next_page_idx<br/>recherche binaire sur la frontiere magic<br/>O log N, pas de balayage du padding"]
    append["append_entry_inner<br/>page pleine donc NOUVELLE TETE,<br/>next_page vers l ancienne<br/>lecture du plus recent vers le plus ancien"]
    walk["walk_chain_unite<br/>PropertyCursor par page, tombes sautees<br/>adresse brute U48, page ou slot"]
    intern["intern_bytes<br/>ajoute longueur u32 + octets au tas<br/>rend un HeapRef stable a vie"]
  end

  subgraph Unites["Unites 512 : additif, garde derriere un flag d environnement"]
    unite_addr["🟠 UniteAddr 48 bits<br/>bit 47 a 0 = page legacy u32<br/>bit 47 a 1 = carrier 4K et unite 1 a 7"]
    slot_page["🟠 SlotPage 512 B<br/>en-tete 24 B + payload 488 B"]
    carrier["🟠 CarrierControl 512 B<br/>magic 0xC5A250C8, nb_unites_utilisees,<br/>version, crc32"]
    pack_flag["🟠 OBRAIN_PROPS_SLOTS_512<br/>DEFaut OFF : production inchangee<br/>carriers a 7 slots non actifs"]
  end

  subgraph Topologie["Topologie : les aretes SONT le stockage, l adjacence est une liste chainee intrusive"]
    nodes_zone["✅ substrate.nodes<br/>tableau plat de NodeRecord 40 B<br/>offset = slot x 40"]
    edges_zone["✅ substrate.edges<br/>tableau plat de EdgeRecord 36 B<br/>offset = slot x 36, slot 0 sentinelle"]
    out_chain["✅ Chaine SORTANTE<br/>entree O 1 par NodeRecord.first_edge_off<br/>puis EdgeRecord.next_from<br/>marche avec garde anti-cycle par set des vus"]
    in_chain["Chaine ENTRANTE<br/>EdgeRecord.next_to existe sur disque<br/>tete en memoire seulement<br/>incoming_heads DashMap, reconstruit O E a l ouverture"]
    splice["splice_edge_at_head<br/>1 lire la tete, 2 ecrire le slot,<br/>3 publier first_edge_off,<br/>4 publier incoming_heads<br/>initialiser AVANT de publier"]
    deg_col["✅ substrate.degrees.node.u32<br/>en-tete 64 B + 8 B par slot<br/>out u32 et in u32, degre en O 1"]
    simplicial["substrate.simplex_dir<br/>SimplexRecord 32 B, membres inline<br/>substrate.simplex_incidence<br/>16 B par slot de noeud + postings"]
  end

  subgraph Durabilite["Durabilite : le journal d abord, la mmap ensuite"]
    wal_rec["✅ WalRecord<br/>en-tete 28 B : length u32, kind u8,<br/>flags u8, reserved u16, lsn u64,<br/>timestamp i64, crc32 u32<br/>payload bincode little-endian fixint"]
    write_node["Writer::write_node<br/>pose ALLOCATED, 1 WAL append,<br/>2 copie dans la mmap"]
    update_prop_head["Writer::update_node_first_prop_off<br/>journalise puis patche 6 octets<br/>a l offset 14 du NodeRecord"]
    checkpoint_mod["checkpoint.rs<br/>msync de toutes les zones,<br/>reecriture de meta en tmp et rename,<br/>trame Checkpoint, WAL tronque"]
    meta_file["✅ substrate.meta 4096 B<br/>MetaHeader 96 B : magic SUBSTRT,<br/>format_version 3, flags,<br/>node_count, edge_count,<br/>last_wal_offset, schema_crc32"]
    dict_file["✅ substrate.dict<br/>labels vers bit 0 a 63,<br/>types d arete vers u16,<br/>cles de propriete vers u16,<br/>next_node_id, next_edge_id"]
    crc_decision["🔴 CRC32 de page<br/>scelle a chaque ecriture,<br/>verifie NULLE PART sur le chemin chaud"]
    legacy_v1["⚪ substrate.props, side-car v1<br/>predecesseur de la zone v2"]
  end

