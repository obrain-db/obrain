subgraph SITESDEC["Sites instrumentes dans la decision d invalidation du graphe"]
  site_compute_head["etape 1 compute_ordinal<br/>tete de ggml_backend_cuda_graph_compute<br/>appelle ggml_obrain_obs_begin_compute"]
  site_atexit_call["etape 14 atexit<br/>ancre chainee : texte insere par l etape 1<br/>appelle ggml_obrain_obs_install_atexit"]
  site_upd_head["etape 2 tete de ggml_cuda_graph_update_required<br/>capture obs_cached_uid, obs_graph_key, obs_bytes0<br/>avant toute decision"]
  site_fast_path["etape 2 chemin rapide uid == graph-uid<br/>appelle ggml_obrain_obs_fast_path_reuse avec 3 arguments<br/>ne consomme PAS d evenement d anneau"]
  site_node_count["etape 3 champ NODE_COUNT<br/>node_props.size != cgraph-n_nodes<br/>obs_first_node = -2 et obs_field = GGML_OBS_FIELD_NODE_COUNT"]
  site_memcmp["etape 4 qualification du champ fautif<br/>boucle memcmp sur graph-node_props avant ecrasement<br/>precedence fixe SRC_DATA_PTR puis SRC_SHAPE_NE puis SRC_STRIDE_NB puis OTHER"]
  site_emit["etape 5 emission de l evenement<br/>ggml_obrain_obs_event_transition avec 6 arguments<br/>le champ est un etat local : son oubli fut le defaut corrige"]
  site_upd_counter["etape 13 update_required<br/>const bool properties_changed<br/>appelle ggml_obrain_obs_update_required"]
end

